{
  "__comment__": "Skeleton for the gitignored secrets.json. Copy to secrets.json and fill REAL values for the Phase-7 cf-dev LIVE run and any opt-in local integration test. The mocked functional suite (tests/functional/) does NOT need this file -- the Azure SDK is patched, so no broker is contacted. Never commit real values.",
  "parameters": {
    "#connection_string": "Endpoint=sb://<namespace>.servicebus.windows.net/;SharedAccessKeyName=<key-name>;SharedAccessKey=<key>",
    "#client_secret": "<service-principal-client-secret>"
  }
}
